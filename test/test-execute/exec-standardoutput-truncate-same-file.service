[Unit]
Description=Test StandardOutput=truncate: when it shares a path with StandardInput=file:

[Service]
StandardInput=file:/tmp/test-exec-standardoutput-same-file-output
StandardOutput=truncate:/tmp/test-exec-standardoutput-same-file-output
StandardError=null
ExecStart=cat
ExecStartPost=test ! -s /tmp/test-exec-standardoutput-same-file-output
Type=oneshot
